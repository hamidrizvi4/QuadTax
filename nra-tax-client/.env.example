# ── Tax Engine connection (read SERVER-SIDE by the /api/* proxy routes) ──
# Base URL of the FastAPI engine.
QUADTAX_ENGINE_URL=http://localhost:8000/api/v1

# Bearer API key for the engine. SERVER-SIDE ONLY.
# Do NOT use the NEXT_PUBLIC_ prefix here — these values are read by Next.js
# API routes at request time and must never be bundled into the browser.
QUADTAX_API_KEY=change-me-to-a-long-random-secret
