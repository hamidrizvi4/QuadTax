# --- AI SDK Keys ---
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# --- Optional: route the OpenAI-SDK calls (OCR + agent classification) through
# an alternate OpenAI-API-compatible provider instead of api.openai.com, e.g.
# OpenRouter. Leave unset to use the OpenAI API directly with OPENAI_API_KEY.
# OpenRouter model ids must be vendor-prefixed (e.g. "openai/gpt-4o").
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_PRIMARY_MODEL=openai/gpt-4o
# OPENAI_SECONDARY_MODEL=openai/gpt-4o-mini

# --- Engine Configuration ---
# Which LLM provider to use for reasoning agents: "anthropic" or "openai"
LLM_PROVIDER=anthropic

# Model identifiers
ANTHROPIC_MODEL=claude-sonnet-4-20250514
OPENAI_MODEL=gpt-4o

# --- Logging ---
LOG_LEVEL=INFO

# --- Authentication ---
# REQUIRED. Bearer API key protecting every data endpoint (/submit, /ocr,
# /packet). The server fails closed (HTTP 503) if this is unset, so the tax
# API never runs unprotected. Use a long, random secret in production.
QUADTAX_API_KEY=change-me-to-a-long-random-secret
